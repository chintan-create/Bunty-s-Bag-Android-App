# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAZORPAY_KEY_ID: Public Razorpay Key ID (e.g., rzp_test_... or rzp_live_...).
# Configure ONLY your Key ID in the Secrets panel in AI Studio (never put Key Secret in the app).
RAZORPAY_KEY_ID=RAZORPAY_KEY_ID_PLACEHOLDER

# PAYMENT_BACKEND_URL: (Optional) Base HTTPS URL of your backend service that creates
# Razorpay orders (/create-razorpay-order) and verifies signatures (/verify-razorpay-payment).
# Leave as placeholder for client-only Test Mode checkout without a backend server.
PAYMENT_BACKEND_URL=PAYMENT_BACKEND_URL_PLACEHOLDER
